{{#if clientes}}
<table class="table table-bordered table-hover table-dark">
    <thead>
        <tr class="text-center">
            <th>Num.</th>
            <th>Nombre</th>
            <th>Apellidos</th>
            <th>Sexo</th>
            <th>Email</th>
            <th>Telefono</th>
            <th>Direccion</th>
            <th>Acciones</th>
        </tr>
    </thead>
    <tbody>
        {{#each clientes}}
            <tr>
                <td>{{@index}}</td>
                <td>{{nombre}}</td>
                <td>{{paterno}} {{materno}}</td>   
                <td>{{sexo}}</td>
                <td>{{email}}</td>
                <td>{{telefono}}</td>
                <td>{{direccion}}</td>
                <td>
                    <a href="/clientes/{{_id}}/update" class="btn btn-info">Actualizar</a>
                    <a href="/clientes/{{_id}}/delete" class="btn btn-danger">Eliminar</a>
                </td>
            </tr>
        {{/each}}
</table>
{{else}}

    <div class="h-100 d-flex align-items-center justify-content-center">
         <div class="text-center text-white">
        <h1>No hay clientes disponibles</h1>
        <img src="/icons/noClientes.png" class="w-75">
    </div>

    </div>
{{/if}}